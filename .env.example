# WeSolar Smart Contracts — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git

# ============================================================
# REQUIRED: Deployer wallet private key
# Get a Celo Alfajores testnet wallet at https://metamask.io
# Fund it with free test tokens at https://faucet.celo.org/alfajores
# ============================================================
PRIVATE_KEY=your_private_key_here

# ============================================================
# Block explorer API keys for contract verification
# Celo: Register at https://celoscan.io
# Base: Register at https://basescan.org
# ============================================================
CELOSCAN_API_KEY=your_celoscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# ============================================================
# Energy oracle address (for SolarPanelRegistry)
# Set after deploying a trusted oracle or Chainlink integration
# ============================================================
ENERGY_ORACLE_ADDRESS=your_oracle_address_here

# ============================================================
# Enable gas reporter in tests (set to "true" to activate)
# ============================================================
REPORT_GAS=
